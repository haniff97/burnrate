# Set these on the SERVER only. Models are configurable; verify provider availability.
GEMINI_API_KEY=
GEMINI_MODEL=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
AI_TIMEOUT_SECONDS=20
BURNRATE_DB=backend/burnrate.db
# In HTTPS deployment use true and set the exact public origin.
BURNRATE_SECURE_COOKIE=false
# BURNRATE_ORIGIN=https://your-backend.example

# Consistent SQLite snapshots on startup and every 6 hours; latest 120 retained.
# BURNRATE_BACKUP_DIR=/mnt/another-disk/burnrate-backups
BURNRATE_BACKUP_INTERVAL_HOURS=6
